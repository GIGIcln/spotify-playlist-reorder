cat > .gitignore << 'EOF'
# Ambienti virtuali Python
spotify-env/
venv/
env/

# File di sistema macOS
.DS_Store
Thumbs.db

# Cache e token di autenticazione (IMPORTANTE per la sicurezza)
.cache
.spotify_token_cache

# Variabili d'ambiente e configurazioni locali
.env
settings.json

# Artifact di build di PyInstaller
build/
dist/
*.spec
EOF